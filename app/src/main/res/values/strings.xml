<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 应用名：同时显示在桌面图标下方和首页标题上 -->
    <string name="app_name">长按器</string>

    <!-- ===== 首页 ===== -->
    <string name="action_toggle_long_press_mode">启动长按器</string>
    <string name="action_exit_app">退出</string>
    <string name="status_not_started">状态：未启动</string>
    <string name="status_running">状态：长按器模式已开启</string>
    <string name="status_pressing">状态：正在长按</string>

    <!-- 首页：悬浮窗权限申请区域 -->
    <string name="overlay_permission_title">还需要「显示在其他应用上层」权限</string>
    <string name="overlay_permission_reason">长按器的控制侧边栏需要悬浮在桌面和其他应用之上，才能在你操作别的 App 时继续使用。请在下个页面打开「允许显示在其他应用上层」开关，然后返回本应用。</string>
    <string name="overlay_permission_hint_not_granted">仍未获得权限，请点击上方按钮重新去系统设置里开启。</string>
    <string name="action_open_overlay_settings">去开启权限</string>
    <string name="action_retry_check">我已开启，重新检查</string>

    <!-- 权限清单（首页） -->
    <string name="permission_checklist_title">运行前需要开启以下权限</string>
    <string name="permission_retry_hint">如果已经开启，请点击下方按钮重新检查。</string>

    <!-- 无障碍服务引导（首页） -->
    <string name="accessibility_permission_title">还需要开启「无障碍服务」</string>
    <string name="accessibility_permission_reason">Android 不允许普通应用向其他应用注入触摸事件，唯一的官方途径是通过无障碍服务。请在下一个页面找到「长按器」并打开开关，然后返回本应用。本应用只用它来执行长按手势，不会读取任何界面内容。</string>
    <string name="action_open_accessibility_settings">去开启无障碍服务</string>

    <!-- 无障碍服务在系统设置里显示的名字与说明 -->
    <string name="accessibility_service_summary">在其他应用上执行长按手势</string>
    <string name="accessibility_service_description">用于「长按器」在你自己选定的屏幕位置执行长按手势。本服务不会读取或记录任何界面内容。</string>

    <!-- ===== 悬浮侧边栏 ===== -->
    <string name="overlay_sidebar_title">长按器</string>
    <string name="overlay_close">关闭</string>

    <string name="action_start_long_press">启动</string>
    <string name="action_stop_long_press">停止</string>

    <!--
      状态文字。
      准星是常驻的，所以"未选择位置""正在选择位置"这类状态已经不存在了：
      只要侧边栏在，准星就在，状态永远显示它当前所在的坐标。
    -->
    <string name="overlay_status_ready">准星位置（%1$d, %2$d）</string>
    <string name="overlay_status_pressing">长按中（%1$d, %2$d）</string>

    <string name="overlay_hint_ready">拖动圆形准星对准目标位置，然后点「启动」。</string>
    <string name="overlay_hint_pressing">正在按住该位置。点击「停止」即可结束长按。</string>
    <string name="overlay_hint_max_duration">注意：Android 系统限制单次手势最长 60 秒，本应用会自动分段续接以持续按住。</string>
    <string name="overlay_hint_accessibility_off">无障碍服务已被关闭，无法执行长按。请在系统设置的「无障碍」中重新开启「长按器」。</string>

    <!-- 操作被拒绝时的提示（需求第七节：缺什么就明确提示什么） -->
    <string name="error_accessibility_disabled">无障碍服务未开启，无法执行长按，正在打开系统设置</string>
    <string name="error_accessibility_not_connected">无障碍服务尚未就绪，请稍后重试</string>
    <string name="error_unsupported_android_version">当前系统版本过低（低于 Android 8.0），无法持续长按。系统限制单次手势最长 60 秒。</string>
    <string name="error_already_pressing">已经在长按中了</string>
    <string name="error_sidebar_covers_target">侧边栏挡住了长按位置，长按事件会被侧边栏接收，请把它拖开</string>

    <!-- Phase 7：异常处理相关提示 -->
    <string name="error_cannot_start_overlay_service">无法启动悬浮窗，请检查本应用的后台运行权限</string>
    <string name="error_overlay_permission_revoked">悬浮窗权限已被关闭，长按器已停止</string>

    <!-- 开始长按时的轻提示 -->
    <string name="overlay_status_pressing_short">已开始长按</string>

    <!-- ===== 通知（前台 Service 必需） ===== -->
    <string name="notification_channel_name">长按器运行状态</string>
    <string name="notification_channel_description">显示长按器侧边栏正在运行</string>
    <string name="notification_title">长按器已启动</string>
    <string name="notification_text">控制侧边栏正在其他应用上层显示</string>
</resources>
