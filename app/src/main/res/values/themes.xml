<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      App 的窗口主题。

      为什么用 Material Components 的父主题（Theme.Material3.*），
      而不是模板默认的 android:Theme.Material.Light.NoActionBar：

      Activity 侧用 Jetpack Compose，其实不太依赖这个 XML 主题；
      但 Material Components 主题同时保证了
      - enableEdgeToEdge() 需要的 windowLightStatusBar 等属性存在；
      - 以后如果在 Activity 里放传统 Material 控件，样式能正确解析。

      注意：**悬浮窗里的界面不要依赖主题属性**。悬浮窗由 Service 添加，
      Service 的 Context 主题来源与 Activity 不同，曾导致 MaterialCardView
      在真机上直接崩溃。所以 overlay_*.xml 里全部用系统原生控件 + 写死的颜色。

      选 DayNight：跟随系统的深色 / 浅色模式。
    -->
    <style name="Theme.LongPressTool" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">?attr/colorSurface</item>
    </style>
</resources>
