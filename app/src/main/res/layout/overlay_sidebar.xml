<?xml version="1.0" encoding="utf-8"?>
<!--
  悬浮侧边栏的布局。

  ===== 为什么全部用系统原生控件，而不是 Material 控件？=====
  这里踩过一个真实的坑，值得记下来：
  Material 控件（MaterialCardView / MaterialButton）在构造时会检查
  "当前主题必须是 Theme.MaterialComponents 的后代"，不满足就直接抛异常。
  而悬浮窗是 **Service** 添加的，Service 的 Context 主题来源和 Activity 不同，
  在真机上完全可能出现取不到应用主题的情况 —— 现象就是点「启动长按器」时闪退。

  所以这个布局刻意做到"零主题依赖"：
  - 卡片用 FrameLayout + 自绘圆角背景，不用 MaterialCardView；
  - 按钮用 android.widget.Button + 自绘 selector；
  - 所有颜色都写死成 @color 常量，不引用 ?attr/xxx 主题属性。

  代价是按钮外观要自己写，换来的是"在任何设备、任何系统版本、任何主题下都不会崩"。

  ===== 为什么用 XML 而不是 Compose？=====
  悬浮窗不属于任何 Activity，要在里面用 Compose 得额外搭 ComposeView + LifecycleOwner
  + SavedStateRegistryOwner 三件套。这个侧边栏只是几个按钮，用 XML 更直接、更好调试。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sidebar_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_card_background"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="216dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== 顶部：标题 + 关闭 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/overlay_sidebar_title"
                android:textColor="@color/overlay_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/button_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="@string/overlay_close"
                android:textColor="@color/overlay_button_secondary_text"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ===== 状态：必须始终可见，让用户一眼知道当前在干什么 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/overlay_status_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp">

            <!--
              状态指示灯：由 StatusDotView 自绘。
              为什么不用「View + shape 背景 + backgroundTint」：
              那样只能硬切颜色，也没法在灯外围加扩散光圈。
              自绘可以做到颜色平滑过渡 + 长按时外圈脉冲（见 StatusDotView）。
              尺寸给到 14dp，是为了给外圈光圈留出空间。
            -->
            <com.example.longpresstool.ui.widget.StatusDotView
                android:id="@+id/status_dot"
                android:layout_width="14dp"
                android:layout_height="14dp" />

            <TextView
                android:id="@+id/text_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/overlay_status_ready"
                android:textColor="@color/overlay_text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!--
          ===== 操作按钮 =====
          只有「启动」和「停止」两个。
          位置不再需要先"选择"再"确认"：圆形准星在侧边栏出现时就一直在，
          用户直接拖动它对准目标位置即可（见 FloatingWindowService 的说明）。
        -->
        <Button
            android:id="@+id/button_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/overlay_button_primary"
            android:text="@string/action_start_long_press"
            android:textColor="@color/overlay_button_primary_text"
            android:textSize="14sp" />

        <Button
            android:id="@+id/button_stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/overlay_button_secondary"
            android:text="@string/action_stop_long_press"
            android:textColor="@color/overlay_button_secondary_text"
            android:textSize="14sp" />

        <!-- ===== 提示文字：说明下一步该做什么 ===== -->
        <TextView
            android:id="@+id/text_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/overlay_hint_ready"
            android:textColor="@color/overlay_text_secondary"
            android:textSize="11sp" />

        <!-- ===== 限制说明：只在「长按中」显示 ===== -->
        <TextView
            android:id="@+id/text_limit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/overlay_hint_max_duration"
            android:textColor="@color/overlay_text_secondary"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
