<?xml version="1.0" encoding="utf-8"?>
<!--
  悬浮侧边栏的布局。

  为什么用 XML 而不是 Compose：
  悬浮窗不属于任何 Activity，要在里面用 Compose 得额外搭 ComposeView + LifecycleOwner
  + SavedStateRegistryOwner 三件套。这个侧边栏只是几个按钮，用 XML 更直接、更好调试。
  以后如果侧边栏变复杂，再评估是否换成 Compose。

  注意：这里没有引入 Material 的 Toolbar/AppBar，标题只是普通 TextView，
  避免把 Material 主题的复杂度带进悬浮窗。
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sidebar_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="216dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ===== 顶部：标题 + 关闭 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/overlay_sidebar_title"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <Button
                android:id="@+id/button_close"
                style="@style/LongPressOverlayButton.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="@string/overlay_close"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ===== 状态：必须始终可见，让用户一眼知道当前在干什么 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?attr/colorSurfaceVariant"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp">

            <!-- 状态指示灯：具体颜色在代码里按状态切换 -->
            <View
                android:id="@+id/status_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/status_dot" />

            <TextView
                android:id="@+id/text_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/overlay_status_not_selected"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
        </LinearLayout>

        <!-- ===== 操作按钮 ===== -->
        <Button
            android:id="@+id/button_select_position"
            style="@style/LongPressOverlayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/action_select_position" />

        <Button
            android:id="@+id/button_start"
            style="@style/LongPressOverlayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/action_start_long_press" />

        <Button
            android:id="@+id/button_stop"
            style="@style/LongPressOverlayButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/action_stop_long_press" />

        <!-- ===== 提示文字：说明下一步该做什么 ===== -->
        <TextView
            android:id="@+id/text_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/overlay_hint_choose_position"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- ===== 限制说明：只在「长按中」显示 ===== -->
        <TextView
            android:id="@+id/text_limit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/overlay_hint_max_duration"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
