<?xml version="1.0" encoding="utf-8"?>
<!--
  圆形准星所在的悬浮窗布局。

  尺寸刻意写成固定值：窗口 60dp x 60dp，准星正好铺满。

  这样"窗口左上角坐标 + 30dp"就是准星圆心在屏幕上的绝对坐标，
  不需要任何跨版本的坐标换算（见 FloatingWindowService 里的说明）。
  窗口尺寸与准星尺寸一致时，拖动窗口就等于拖动准星，圆心永远在窗口正中。

  这里只有准星本身：坐标不再显示在准星下方（避免遮挡和视觉干扰），
  当前坐标显示在侧边栏的状态区里。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="60dp"
    android:layout_height="60dp">

    <com.example.longpresstool.ui.widget.TouchIndicatorView
        android:id="@+id/touch_indicator"
        android:layout_width="60dp"
        android:layout_height="60dp" />

</FrameLayout>
