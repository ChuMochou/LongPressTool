<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      悬浮窗权限：显示在其他应用上层。

      这是"特殊权限"，无法用运行时弹窗申请，用户必须去系统设置里手动打开开关。
      引导流程见 permission/OverlayPermission.kt 和 MainActivity。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 前台 Service：Android 9 (API 28) 起必须声明这个普通权限。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!--
      Android 14 (API 34) 起，前台 Service 必须声明"类型"，并申请与该类型对应的权限。
      本应用的类型是 specialUse：它不是导航、播放、定位等任何标准类别，
      只是"与其他应用交互的悬浮控制面板"，这正是 specialUse 的设计用途。
      声明后仍要在代码里调用 startForeground(id, notification, type)，见 FloatingWindowService。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
      Android 13 (API 33) 起，显示通知需要用户授权。前台 Service 的常驻通知也受影响。
      不申请的话通知不会显示（Service 本身仍能升为前台，但用户看不到提示）。
      运行时申请逻辑在 MainActivity 里。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".LongPressToolApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LongPressTool">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.LongPressTool"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          悬浮侧边栏的后台 Service。

          几个属性的理由：
          - exported="false"：只允许本应用启动，别让外部应用拉起它。
          - foregroundServiceType="specialUse"：Android 14+ 的强制要求，
            并且必须给一个 <property> 说明用途，否则部分应用商店/系统校验会不通过。
          - stopWithTask="true"：用户从最近任务里划掉应用时，顺便关掉侧边栏，
            避免"应用都没了，悬浮窗还挂在屏幕上"的困惑（见需求第十三节：异常情况）。
            注意：不同 ROM 对这个属性的实现不完全一致，所以代码里另有
            FloatingWindowService.onTaskRemoved() 做同一件事作为兜底。
          - configChanges：屏幕旋转/尺寸变化时不重建 Service，
            侧边栏不会闪一下；具体处理见 FloatingWindowService.onConfigurationChanged()。
        -->
        <service
            android:name=".service.FloatingWindowService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="悬浮控制面板：让用户在其他应用之上选择长按位置并触发长按手势" />
        </service>

        <!--
          执行长按手势的无障碍服务。

          这是整个项目最关键的声明，逐条解释：

          - android:permission="@android:permission/BIND_ACCESSIBILITY_SERVICE"：
            只有系统能绑定这个服务，其他应用不能。**必须**写，否则服务不会出现在
            系统设置的无障碍列表里（或者能被别的应用直接拉起，属于安全漏洞）。

          - android:exported="true"：必须为 true。因为绑定它的是**系统**（外部进程），
            不导出的话系统绑不上。安全性由上一条的 permission 保证。

          - <intent-filter> + ACCESSIBILITY_SERVICE action：
            这是无障碍服务被系统识别并显示在设置列表里的标志，缺一不可。

          - android:label：显示在系统无障碍设置页里的服务名。用户得靠它找到我们，
            所以用"长按器"这个名字，和 App 名一致，方便用户对应。

          - android:description / android:summary：分别指向 strings.xml 里的说明文字，
            向用户解释这个服务做什么。描述不清用户不敢开。配置细节（例如
            canPerformGestures）在 res/xml/accessibility_service_config.xml 里。

          - android:exported 与 meta-data 里的配置共同决定能力：
            我们只申请"派发手势"，**不**申请"读取窗口内容"。
        -->
        <service
            android:name=".service.LongPressAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:description="@string/accessibility_service_description"
            android:summary="@string/accessibility_service_summary"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
